# Set canonical public URL at build time AND runtime on Cloudflare.
NEXT_PUBLIC_SITE_URL=https://www.ducnh.tech
# Required for admin login, revocable sessions and blog persistence.
MONGODB_URI=
MONGODB_DB=portfolio
ADMIN_USERNAME=admin
# Generate with npm run admin:setup. No plaintext password or ADMIN_SECRET.
ADMIN_PASSWORD_HASH=
# Local only; production uses https://www.ducnh.tech (no trailing slash).
ADMIN_ORIGIN=http://localhost:3000
# Optional contact email delivery.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# Optional blog media uploads. R2 S3 credentials stay server-side; public bucket domain has no trailing slash.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
